use finan_db;
-- ¿Cuál es la tendencia de gasto a corto plazo de cada cuenta en cada transacción, comparando el monto actual 
-- frente al promedio smoothing de sus últimas 3 transacciones (incluyendo la actual)?
WITH PromediosMovimientos AS (
    SELECT tr.cuenta_id,
        tr.transaccion_id,
        tr.monto,
        tr.fecha_hora,
        AVG(tr.monto) OVER (
            -- CTE promedio_ultimas_3_transacciones
            PARTITION BY tr.cuenta_id -- se divide por cuenta_id
            ORDER BY tr.fecha_hora ASC,
                tr.transaccion_id -- ordenado por fecha_hora y transaccion_id para evitar empates
                ROWS BETWEEN 2 PRECEDING AND CURRENT ROW -- promedio de las 2 transacciones anteriores y la actual // se usa la clausula ROWS PARA CREAR UNA ventana DESLIZANTE DE 3 FILAS
        ) AS promedio_ultimas_3_transacciones
    FROM transacciones tr
)
SELECT pm.cuenta_id,
    pm.transaccion_id,
    pm.monto,
    pm.promedio_ultimas_3_transacciones,
    CASE
        -- Se evalua la tendencia de gasto a corto plazo
        WHEN pm.monto > pm.promedio_ultimas_3_transacciones THEN 'Alto' -- si el monto es mayor al promedio de las ultimas 3 transacciones
        WHEN pm.monto < pm.promedio_ultimas_3_transacciones THEN 'Bajo' -- si el monto es menor al promedio de las ultimas 3 transacciones
        ELSE 'Igual' -- si el monto es igual al promedio de las ultimas 3 transacciones
    END AS tendencia_gasto_corto_plazo
FROM PromediosMovimientos pm
ORDER BY pm.cuenta_id,
    pm.fecha_hora desc;
-- se ordena de mayor a menor
--------------------------------------- SEGUNDA PREGUNTA ----------------------------------------- 
-- prom_movil_con_actual: El promedio de las 2 anteriores + la actual (tu ventana original).
-- prom_movil_historico_puro: El promedio exclusivo de las 3 transacciones anteriores (sin incluir la transacción actual).
WITH VentanaMovimientos AS (
    SELECT tr.cuenta_id,
        tr.transaccion_id,
        tr.monto,
        tr.fecha_hora,
        -- Promedio móvil simple: incluye transacciones anteriores y la actual.
        -- La ventana se define por filas (ROWS BETWEEN 2 PRECEDING AND CURRENT ROW).
        -- Esto hace que para la fila N, se incluyan las filas N, N-1 y N-2.
        -- Como el ORDER BY es ASC, las filas N-1 y N-2 son efectivamente las 2 transacciones anteriores.
        AVG(tr.monto) OVER (
            PARTITION BY tr.cuenta_id
            ORDER BY tr.fecha_hora ASC,
                tr.transaccion_id ASC ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
        ) AS prom_movil_con_actual,
        -- Promedio móvil histórico puro: considera solo las transacciones ANTERIORES.
        -- La ventana se define por el rango de fechas relativo (RANGE BETWEEN INTERVAL 3 MONTH PRECEDING AND INTERVAL 1 MICROSECOND PRECEDING).
        -- Esto hace que se incluyan todas las transacciones que ocurrieron en los 3 meses anteriores a la fecha de la fila actual.
        -- Usamos INTERVAL 1 MICROSECOND PRECEDING para excluir la fila actual, ya que RANGE trabaja con valores de la columna ORDER BY (fecha_hora).
        AVG(tr.monto) OVER (
            PARTITION BY tr.cuenta_id
            ORDER BY tr.fecha_hora ASC,
                tr.transaccion_id ASC ROWS BETWEEN 3 PRECEDING AND 1 PRECEDING
        ) AS prom_movil_historico_puro,
        -- Conteo de elementos reales de la ventana
        count(tr.monto) over (
            partition by tr.cuenta_id
            order by tr.fecha_hora asc,
                tr.transaccion_id asc rows between 3 preceding and 1 PRECEDING
        ) as tx_previas_disponibles
    FROM transacciones tr
)
SELECT vm.cuenta_id,
    vm.transaccion_id,
    vm.monto,
    vm.fecha_hora,
    vm.prom_movil_con_actual,
    coalesce(vm.prom_movil_historico_puro, 0) AS prom_movil_historico_puro,
    vm.tx_previas_disponibles,
    CASE
        WHEN vm.prom_movil_historico_puro IS NULL THEN 'Sin historial previo'
        when vm.monto > (vm.prom_movil_historico_puro * 1.5) then 'Anomalia / Gasto inusualmente alto'
        when vm.monto > vm.prom_movil_historico_puro THEN 'Alto, por ensima de la media'
        when vm.monto < (vm.prom_movil_historico_puro * 0.5) THEN 'Anomalia / Gasto inusualmente bajo'
        when vm.monto < vm.prom_movil_historico_puro THEN 'Bajo, por debajo de la media'
        ELSE 'Igual al historial'
    END AS evaluacion_riesgo
FROM VentanaMovimientos vm
ORDER BY vm.cuenta_id,
    vm.fecha_hora ASC;
--------------------------------------- TERCERA PREGUNTA -----------------------------------------
-- Población: solo débitos.
-- Orden: transacciones cronológicamente por cuenta.
-- Referencia: las 3 transacciones anteriores.
-- La transacción actual no participa en su propia referencia.
-- Promedio histórico: media de esas 3 transacciones.
-- Desviación absoluta: actual − promedio.
-- Desviación relativa: (actual − promedio) / promedio.
-- Menos de 3 transacciones anteriores: no hay suficiente historial → NULL.
-- Promedio histórico = 0: desviación relativa no calculable → NULL y clasificación separada.
-- Una desviación alta no equivale automáticamente a una anomalía: todavía necesitaríamos definir un criterio para determinar qué magnitud consideramos inusual.
WITH promedio_historico as (
    SELECT transaccion_id,
        cuenta_id,
        monto,
        fecha_hora,
        AVG(monto) OVER (
            -- se divide por cuenta_id para separar transacciones por cuenta
            partition BY cuenta_id
            order by fecha_hora asc,
                transaccion_id asc rows between 3 preceding and 1 preceding -- se ordenan por fecha_hora y transaccion_id para evitar empates
        ) as promedio_historico_puro
    FROM transacciones tr
        inner join tipos_transaccion tt on tr.tipo_id = tt.tipo_id -- se unen las tablas transacciones y tipos_transaccion
    where tt.naturaleza = 'debito' -- se filtran solo las transacciones de tipo debito
),
desviacion_absoluta as (
    SELECT p.cuenta_id,
        p.transaccion_id,
        p.monto,
        p.fecha_hora,
        p.promedio_historico_puro,
        CASE
            WHEN (p.monto - p.promedio_historico_puro) > 0 THEN (p.monto - p.promedio_historico_puro) -- si el monto es mayor al promedio historico
            ELSE (p.promedio_historico_puro - p.monto) -- si el monto es menor al promedio historico
        END AS desviacion_absoluta
    FROM promedio_historico p
),
desviacion_relativa as (
    SELECT d.cuenta_id,
        d.transaccion_id,
        d.monto,
        d.fecha_hora,
        d.promedio_historico_puro,
        d.desviacion_absoluta,
        (d.monto - d.promedio_historico_puro) / d.promedio_historico_puro as desviacion_relativa -- se divide la desviacion absoluta entre el promedio historico para obtener la desviacion relativa
    FROM desviacion_absoluta d
)
SELECT r.cuenta_id,
    r.transaccion_id,
    r.monto,
    r.fecha_hora,
    r.promedio_historico_puro,
    r.desviacion_absoluta,
    r.desviacion_relativa,
    CASE
        WHEN r.desviacion_relativa > 0.5 THEN 'Gasto significativamente alto' -- si la desviacion relativa es mayor a 0.5
        WHEN r.desviacion_relativa < -0.5 THEN 'Gasto significativamente bajo' -- si la desviacion relativa es menor a -0.5
        ELSE 'Gasto normal' -- si la desviacion relativa es mayor a -0.5 y menor a 0.5
    END AS clasificacion
FROM desviacion_relativa r
WHERE r.promedio_historico_puro > 0 -- se filtran las transacciones que tienen un promedio historico mayor a 0
ORDER BY r.cuenta_id,
    r.fecha_hora ASC;
--GRANULARIDAD:
--Una fila representa una transaccion individual
--POBLACIÓN:
--La variable se calcula sobre solo transacciones de débito.
--REFERENCIA:
--El gasto actual se compara contra el gasto promedio de las 3 transacciones anteriores.
--DESVIACIÓN RELATIVA:
--Representa la diferencia entre el gasto actual y el gasto promedio de las 3 transacciones anteriores, dividido por el gasto promedio de las 3 transacciones anteriores.
--CLASIFICACIÓN:
--Un gasto significativamente alto significa que el gasto actual es mayor al promedio de las 3 transacciones anteriores en un 50% más.
--LIMITACIÓN:
--La variable mide cuánto se desvía una transacción de débito respecto al promedio de las tres transacciones débito anteriores de la misma cuenta. 
--La desviación relativa permite expresar esa diferencia proporcionalmente y conservar su dirección. 
--La clasificación utiliza un umbral de ±50% para identificar gastos significativamente altos o bajos. 
--Sin embargo, esta clasificación no constituye por sí sola una prueba estadística de anomalía.
